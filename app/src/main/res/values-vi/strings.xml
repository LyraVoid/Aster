    <string name="settings_magic_mount">Magic mount</string>
    <string name="settings_magic_mount_summary">Bật tính năng gắn kết mô-đun tích hợp thay cho mô-đun meta. Thay đổi có hiệu lực sau khi khởi động lại.</string>
    <string name="module_mount_unavailable">Tính năng gắn kết không khả dụng. Hãy bật Magic mount hoặc cài một mô-đun meta gắn kết, rồi khởi động lại.</string>
    <string name="module_mount_meta_disabled">Magic mount đang tắt và mô-đun meta bị vô hiệu hoá. Hãy bật một phương thức gắn kết, rồi khởi động lại.</string>
    <string name="module_mount_meta_removing">Magic mount đang tắt và mô-đun meta đang chờ gỡ. Hãy bật Magic mount hoặc giữ lại mô-đun meta, rồi khởi động lại.</string>
    <string name="runtime_safety_title">Ẩn &amp; bỏ gắn kết mô-đun</string>
    <string name="runtime_safety_summary">Ẩn các thuộc tính trạng thái khởi động hoặc tạm thời bỏ gắn kết tài nguyên mô-đun</string>
    <string name="runtime_safety_description">Mặc định tắt. Hãy xem trước, sau đó dùng thử trong 60 giây. Chỉ giữ lại sau khi đã kiểm tra kết quả. Chế độ an toàn sẽ tắt cả hai tính năng và cố gắng khôi phục. Việc khởi động lại không bao giờ bật lại chúng. Mỗi lần chỉ chạy được một phiên.</string>
    <string name="runtime_safety_unavailable">Đang tải hoặc không khả dụng. Hãy cài đặt phiên bản AndroidPatch tương ứng từ Trang chủ.</string>
    <string name="runtime_safety_safe_mode">Kiểm tra an toàn đã chặn kích hoạt. Các tính năng vẫn tắt sau khi rời chế độ an toàn.</string>
    <string name="runtime_safety_preview">Bản xem trước đã sẵn sàng; chưa có gì bị thay đổi.</string>
    <string name="runtime_safety_applying">Đang áp dụng kèm bản ghi khôi phục…</string>
    <string name="runtime_safety_trial">Đang chạy thử. Tự động khôi phục sau 60 giây trừ khi bạn chọn Giữ lại.</string>
    <string name="runtime_safety_active">Đã giữ cho lần khởi động này. Bạn có thể khôi phục bất cứ lúc nào.</string>
    <string name="runtime_safety_recovery_failed">Khôi phục chưa hoàn tất. Các bản sao lưu vẫn được giữ; hãy kiểm tra nhật ký trước khi thử lại.</string>
    <string name="runtime_safety_restoring">Đang khôi phục…</string>
    <string name="runtime_safety_off">Tắt</string>
    <string name="runtime_safety_hide_description">Thay đổi bốn thuộc tính hiển thị trạng thái khởi động nếu chúng tồn tại. Không khoá lại bootloader hay thay đổi cài đặt ADB, gỡ lỗi hoặc ghi nhật ký.</string>
    <string name="runtime_safety_hide_preview">Xem trước thay đổi của Ẩn</string>
    <string name="runtime_safety_umount_description">Nâng cao: tách biệt với Ẩn. Nhập tối đa 16 đường dẫn tài nguyên mô-đun, mỗi dòng một đường dẫn. Các dòng trùng lặp sẽ bị loại bỏ. Mọi mục đều phải vượt qua bước xem trước; nếu có lỗi trong khi thực thi, các mục đã thử sẽ được khôi phục theo thứ tự ngược lại. Chỉ chấp nhận các gắn kết tệp media, phông chữ và overlay riêng tư từ mô-đun, bất kể gắn kết là chỉ đọc hay ghi được; các cờ gắn kết ban đầu sẽ được phát lại khi khôi phục.</string>
    <string name="runtime_safety_module_path">Đường dẫn tài nguyên mô-đun, mỗi dòng một đường dẫn</string>
    <string name="runtime_safety_umount_preview">Xem trước tất cả việc bỏ gắn kết tài nguyên</string>
    <string name="runtime_safety_start_trial">Bắt đầu dùng thử 60 giây</string>
    <string name="runtime_safety_keep">Giữ cho lần khởi động này</string>
    <string name="runtime_safety_restore">Khôi phục và tắt</string>
    <string name="runtime_safety_logs">Xem nhật ký thao tác</string>
    <string name="runtime_safety_logs_empty">Chưa có nhật ký thao tác.</string>
    <string name="runtime_safety_hide_title">Ẩn · hiển thị trạng thái khởi động</string>
    <string name="runtime_safety_hide_steps">Tính năng Ẩn không cần đường dẫn. Hãy bấm Xem trước, rồi Bắt đầu dùng thử. Kiểm tra kết quả và bấm Giữ lại trong vòng 60 giây; nếu không, các thay đổi sẽ tự động được khôi phục. Khôi phục và tắt luôn khả dụng.</string>
    <string name="runtime_safety_umount_title">Bỏ gắn kết tài nguyên mô-đun · nâng cao</string>
    <string name="runtime_safety_already_matches">Bốn thuộc tính được kiểm tra đã khớp với mục tiêu của Ẩn. Không cần thay đổi gì. Điều này không có nghĩa là tính năng đang hoạt động.</string>
    <string name="runtime_safety_properties_unavailable">Một số thuộc tính bị thiếu hoặc không đọc được nên không thể xác nhận trạng thái của chúng. Chỉ những thuộc tính đọc được thành công và khác mục tiêu mới được đưa vào bản xem trước.</string>
    <string name="runtime_safety_legacy_no_changes">Không cần thay đổi gì. APD cũ hơn không trả về chi tiết kiểm tra; hãy cập nhật AndroidPatch từ Trang chủ để xem kết quả chính xác.</string>
    <string name="runtime_safety_module_examples">Ví dụ (thay bằng ID mô-đun và đường dẫn thực tế của bạn):\nmymodule/system/media/bootanimation.zip\nmymodule/product/fonts/example.ttf</string>
    <string name="runtime_safety_auto_title">Khi khởi động</string>
    <string name="runtime_safety_auto_off">Tự động kích hoạt đang tắt. Không có gì chạy trừ khi bạn xem trước và áp dụng tại đây.</string>
    <string name="runtime_safety_auto_notice">Tự động kích hoạt sẽ chạy kiểm tra mới ở mỗi lần khởi động và không bao giờ dùng lại kết quả trước đó. Chế độ an toàn, kiểm tra an toàn không khả dụng, kiểm tra thất bại hoặc lần khởi động trước không hoàn tất sạch sẽ sẽ tắt lại tuỳ chọn này và giữ nguyên các đường dẫn đã lưu cùng nhật ký. Hành vi này vẫn cần được kiểm chứng trên một lần khởi động lại thực tế.</string>
    <string name="runtime_safety_hide_auto">Tự động ẩn ở mỗi lần khởi động</string>
    <string name="runtime_safety_umount_auto">Tự động bỏ gắn kết ở mỗi lần khởi động</string>
    <string name="runtime_safety_probe">Ghi chẩn đoán khởi động (chỉ đọc)</string>
    <string name="runtime_safety_probe_description">Ghi lại những gì mỗi giai đoạn khởi động quan sát được: danh tính, ngữ cảnh SELinux, không gian tên gắn kết, trạng thái KernelPatch, các gắn kết mô-đun và chế độ an toàn. Nó chỉ ghi một dòng nhật ký và không thay đổi gì khác, nhờ đó có thể xác nhận một sự kiện khởi động mà không cần mở ứng dụng này.</string>
    <string name="runtime_safety_save_paths">Chỉ lưu đường dẫn</string>
    <string name="runtime_safety_paths_saved">Đường dẫn đã lưu: %1$d</string>
    <string name="runtime_safety_need_paths">Hãy nhập ít nhất một đường dẫn tài nguyên mô-đun trước khi bật tự động bỏ gắn kết.</string>
    <string name="runtime_safety_auto_running">Tuỳ chọn đã bật: %1$s</string>
    <string name="runtime_safety_auto_record">Bản ghi tự động: %1$s</string>
    <string name="runtime_safety_auto_interrupted">Lần khởi động trước không hoàn tất sạch sẽ nên tuỳ chọn tự động đã bị tắt. Hãy kiểm tra nhật ký, rồi bật lại khi kết quả có vẻ đúng.</string>
    <string name="runtime_safety_active_auto">Đã được áp dụng tự động khi khởi động. Dùng Khôi phục và tắt để hoàn tác; sau đó tự động kích hoạt sẽ vẫn tắt.</string>
    <string name="runtime_safety_auto_hint">Bật một tuỳ chọn tự động sẽ lưu các đường dẫn đang hiển thị và có hiệu lực từ lần khởi động tiếp theo. Nó không bao giờ bỏ gắn kết bất cứ thứ gì ngay lúc này.</string>
</resources>
