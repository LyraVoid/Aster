# Release signing for Aster. Copy this file to keystore.properties (which is not committed) and
# fill in your own keystore, or set the same four names as environment variables in CI.
#
# The keystore is the app's identity: an update is only accepted by the devices that already have
# the app if it is signed with the same key, and anything signed with a different key is a
# different app. Keep a backup of the .jks and of its password somewhere that outlives this
# working copy, and never commit either.
#
# The certificate's SHA-256 is also what the kernel side trusts as the manager (see the
# KernelPatch fork's trusted-manager table), so changing the key means every user must re-install
# and, for a patched device, re-patch.

KEYSTORE_FILE=key.jks
KEYSTORE_PASSWORD=your-keystore-password
KEY_ALIAS=aster
KEY_PASSWORD=your-key-password
